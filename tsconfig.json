{
  "compilerOptions": {
    /* Basic Options */
    "target": "ES5",
    "module": "commonjs", 
    "lib": [ "es2017", "DOM" ],    
    "sourceMap": true,
    "noUnusedLocals": true,  
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "moduleResolution": "node" ,
    "rootDir": "./",
    "baseUrl": ".",
    "skipLibCheck": true,
    "lib": [ "es2022", "DOM" ],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "./common/ts/**/*.ts",
    "./commonv5/ts/**/*.ts",
    "./extensions/**/*.ts"
  ]
}